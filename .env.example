# "Meet with a food forest designer" emails go out through Resend (https://resend.com, free tier is plenty).
# Without these, leads are only logged to the server console.
NUXT_RESEND_API_KEY=
NUXT_LEAD_TO_EMAIL=
# Must be a sender on a domain you've verified in Resend (onboarding@resend.dev works for testing to your own address)
NUXT_LEAD_FROM_EMAIL="Plant a Food Forest <onboarding@resend.dev>"
